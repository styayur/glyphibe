{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window: no shell, filesystem or network plugin access.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-open-repository",
    "allow-startup-repository",
    "allow-cancel-scan",
    "allow-query-impact",
    "allow-explain-node",
    "allow-read-source",
    "allow-window-action"
  ]
}
